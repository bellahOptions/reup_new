APP_NAME=ReUp
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Must match the origin the browser actually uses. `php artisan serve` — and
# docs/RUNNING.md — serve at 127.0.0.1:8000, so `http://localhost` (or a
# missing port) makes every absolute URL this app generates point at a
# *different origin* than the page on screen. See the CSP note in
# docs/RUNNING.md: form-action 'self' then blocks the app's own forms.
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=reup
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log 
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

# Password for the administrator created by
# `php artisan db:seed --class=AdminSeeder` (superadmin@reup.com.ng).
# Leave blank to use the built-in development password, which the seeder prints
# when it runs. Minimum 12 characters, matching Rules\Password::min(12).
# In production the seeder refuses to use the built-in default unless
# ADMIN_SEED_ALLOW_PRODUCTION=true is also set.
ADMIN_SEED_PASSWORD=
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@reup.com.ng"
# Sender name on every outbound email. Do NOT set this to "${APP_NAME}": dotenv
# resolves that against the process environment before reading .env, so an
# exported APP_NAME (Laravel's default is literally "Laravel") ends up on
# customer receipts. Leave it unset to use the literal in config/mail.php.
MAIL_FROM_NAME="ReUp by Bellah Options"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# ---------------------------------------------------------------------------
# Payment gateway — Paystack (primary card rail)
# ---------------------------------------------------------------------------
# Server-side secret. Also used to verify the webhook signature, so it must be
# set or POST /paystack/webhook returns 503 and card funding cannot settle.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# The transaction split every card checkout is initialised with. Paystack applies
# the split's own percentage and subaccount at settlement, so this routes the
# platform's share. Sent to the gateway, never chosen by the customer, and it
# applies to every Paystack checkout — a checkout that omits it settles wholly
# into the main account, which nobody notices until reconciliation.
#
# The SPL_ code from the Paystack dashboard (Splits). Set it to empty to disable
# splitting entirely. A malformed value is refused at initialisation rather than
# sent, because a code that is *accepted* but is the wrong split misroutes money
# silently — see PaystackService::splitCode().
#
# Note: this governs card checkouts. A transfer into a dedicated virtual account
# is settled by the split configured when that account was created; the DVA
# endpoint takes no per-transaction split code.
PAYSTACK_SPLIT_CODE=SPL_YsS8nTY0UJ

# ---------------------------------------------------------------------------
# Payment gateway — Bachs (FALLBACK card rail)
# ---------------------------------------------------------------------------
# Used only when Paystack fails to start a checkout. It is not a payment method
# the customer picks; the app routes "Card" to it automatically and records the
# gateway on the transaction. Leave BACHS_ENABLED unset and none of this runs.
#
# Keys: Bachs developer portal -> API keys. `sk_sandbox_...` works against
# sandbox-api.bachs.io (the default base URL); going live is a key swap to
# `sk_live_...` plus BACHS_BASE_URL=https://api.bachs.io.
BACHS_ENABLED=false
BACHS_SECRET_KEY=
BACHS_BASE_URL=https://sandbox-api.bachs.io

# Webhook signing secret from the endpoint in the Bachs developer portal.
# POST /bachs/webhook refuses to run at all unless this is set — it is the only
# thing authenticating the request. Subscribe the endpoint to
# collection.succeeded, collection.failed and collection.underpaid.
BACHS_WEBHOOK_SECRET=

# The payment corridor Bachs is told to offer. NGN_CARD is the naira card rail.
# If it is not enabled on the account, checkout creation fails with
# CHECKOUT_RESTRICTION_LEAVES_NO_PAYMENT_METHOD or ACCOUNT_NOT_ACTIVATED and
# the fallback fails closed to the funding form. Confirm the corridor with
# support@bachs.io before switching this on.
BACHS_PAYMENT_METHOD_TYPE=NGN_CARD

# ---------------------------------------------------------------------------
# Airtime / data / bill vending upstream
# ---------------------------------------------------------------------------
# Without these, AirtimeDataController refuses purchases with a clear
# "temporarily unavailable" message rather than fataling.
CLUBKONNECT_CLIENT_ID=
CLUBKONNECT_API_KEY=
CLUBKONNECT_BASE_URL=https://www.clubkonnect.com

# ---------------------------------------------------------------------------
# Operational addresses (used by the UI and by transaction notifications)
# ---------------------------------------------------------------------------
SUPPORT_EMAIL=support@reup.com.ng
SUPPORT_PHONE="+234 907 601 7916"
OPS_EMAILS="reup.bellahoptions@gmail.com,support@reup.com.ng"

# Google Analytics measurement ID. Leave blank to disable analytics entirely.
GOOGLE_ANALYTICS_ID=

# ---------------------------------------------------------------------------
# Bill-payment providers
# ---------------------------------------------------------------------------
# Which customer-facing services are live
# ---------------------------------------------------------------------------
# Three lists, comma-separated. The difference between the last two is entirely
# what the customer is told:
#
#   REUP_SERVICES               services that work and sell
#   REUP_SERVICES_COMING_SOON   pages that announce the feature; nothing can be
#                               bought. A 200 with a "coming soon" page, because
#                               a link in an email or an ad should land somewhere
#                               that explains itself rather than on a 404.
#   REUP_SERVICES_DISABLED      pages that refuse. A 503, not a 404 — the route is
#                               real and the customer did not mistype it.
#
# Valid names, from config/features.php:
#   airtime, data, social_boost, cable_tv, electricity, waec_pin, jamb_pin, betting
#
# THE DEFAULT IS THAT EVERYTHING IS LIVE. That is deliberate: a deployment that has
# never heard of these variables behaves exactly as it did before they existed, so a
# forgotten line here is not an outage.
#
# Setting REUP_SERVICES changes that. It becomes the authoritative live list, and
# anything not named in it — and not named below — falls to COMING SOON. That is the
# opt-in to strict behaviour and it is what you want in production: a service added
# to config/features.php later cannot go live by accident.
#
# Example: airtime and data live, Social Boost announced but not selling, betting
# refused outright.
#
#   REUP_SERVICES=airtime,data
#   REUP_SERVICES_COMING_SOON=social_boost
#   REUP_SERVICES_DISABLED=betting
#
# A service named in more than one list is resolved most-restrictive-first, so an
# ambiguous instruction refuses to sell rather than selling.
REUP_SERVICES=
REUP_SERVICES_COMING_SOON=
REUP_SERVICES_DISABLED=

# ---------------------------------------------------------------------------
# Failover order. For each purchase the platform walks this list, skipping
# providers that are unconfigured, do not support the product, or whose float
# cannot cover the charge, and uses the first that accepts the request.
BILL_PROVIDER_ORDER=clubkonnect,pairgate

# Consult provider float before charging a customer. Leave on: it is what stops
# a customer being debited for a vend the provider cannot fulfil.
BILL_CHECK_PROVIDER_BALANCE=true

# Probe each provider before starting a purchase. If none answer, the sale is
# refused and no money moves, rather than debiting for a vend that cannot happen.
BILL_CHECK_PROVIDER_HEALTH=true

# Vend through the cheapest provider that can serve the purchase. Only applies
# when every candidate can be priced; otherwise BILL_PROVIDER_ORDER decides.
BILL_OPTIMISE_COST=true

# Naira held back so a provider is never spent to exactly zero.
BILL_PROVIDER_HEADROOM=500

# Alternative vendor (leave blank to run on ClubKonnect alone).
# Docs: https://pairgate.com/developers/introduction. The key is sent as a
# Bearer token. Plan/bouquet ids and network/disco slugs are mapped in
# config/bills.php under `pairgate`.
PAIRGATE_API_KEY=
PAIRGATE_BASE_URL=https://pairgate.com/api/v1
# Prefixes every call with /test: Pairgate answers without charging the wallet.
# For smoke tests only — never enable in production.
PAIRGATE_TEST_MODE=false
# Signing secret for POST /pairgate/webhook, shown once when HMAC signing is
# enabled for the API key in the Pairgate dashboard. Empty means the endpoint
# answers 503 and no token, PIN or post-acceptance failure is ever recorded.
PAIRGATE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Wave 1 providers
# ---------------------------------------------------------------------------
# These serve the newer products — Internet/Broadband, Education, ePIN, eSIM,
# gifting, International Top-up/Data, Gift Cards, SMM — through
# App\Providers\ProviderRegistry, which is separate from the ClubKonnect/Pairgate
# path above and does not affect it.
#
# Credentials are read from the environment at call time by
# App\Providers\Support\ProviderCredentials. They are never written to
# config or the database, so `config:cache` cannot capture a secret and a debug
# endpoint cannot dump one. Leave a value blank to disable that provider: an
# unconfigured provider is skipped by the router rather than attempted.
#
# Which provider serves a capability is the Super Admin's `providers` table
# (priority / is_primary / capabilities), edited at /admin/providers.

# Point every Wave 1 provider at its sandbox. Displayed in the admin console.
# For smoke tests only — sandbox balances and costs are not real.
PROVIDER_SANDBOX=false

# Sogo — Nigerian digital and bill services, plus gift cards (buy).
# Docs: https://developer.sogo.africa/docs. Sent as `Authorization: Bearer`.
# Scoped keys are optional and preferred: a read-only key cannot move money.
#   SOGO_READ_KEY / SOGO_WRITE_KEY
#   SOGO_GIFT_CARDS_READ_KEY / SOGO_GIFT_CARDS_WRITE_KEY
# The general key is the fallback for every scope.
SOGO_API_KEY=
SOGO_SECRET_KEY=
SOGO_BASE_URL=https://api.sogo.africa/v1
SOGO_SANDBOX_BASE_URL=https://sandbox.sogo.africa/v1

# VTUGate — international airtime and data.
# Docs: https://vtugate.com/docs. Sent as `Authorization: Bearer`. 60 req/min.
#
# IMPORTANT: VTUGate's published reference does not contain the request *field
# names* for its international endpoints — the page is client-rendered and the
# bodies are not retrievable. This integration therefore reads every field name
# from config/providers.php -> vtugate.fields and refuses to be routed to until
# an operator confirms them against the vendor. Until then the international
# route uses VTpass, which is fully documented.
#
# To bring VTUGate live: confirm each name in `vtugate.fields` and
# `vtugate.response_fields`, correct any that differ, then set this to true.
VTUGATE_FIELDS_VERIFIED=false
VTUGATE_KEY=
# The Test API Key returns mocked responses with no wallet impact. Any
# phone/meter/smartcard number ending 1111 simulates a failure.
VTUGATE_TEST_KEY=

# VTpass — international airtime and data (controlled fallback).
# Docs: https://vtpass.com/documentation/foreign-airtime/
# Authentication is per method, which is not a detail: a GET carries the public
# key and a POST carries the secret key. All three are needed.
#   api-key + public-key  on reads
#   api-key + secret-key  on writes
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=
VTPASS_BASE_URL=https://vtpass.com/api
VTPASS_SANDBOX_BASE_URL=https://sandbox.vtpass.com/api

# Nitro NG — SMM / social boost.
# Docs: https://nitro.ng/resellers/docs. The key is a form field, not a header.
# `NITRO_KEY` is what the credential resolver looks for (it also accepts
# NITRO_API_KEY). It identifies the account, applies the reseller rates and
# charges the Nitro wallet, so it stays server-side.
NITRO_KEY=
NITRO_BASE_URL=https://nitro.ng/api/v2

# --- Social Boost (SMM) ------------------------------------------------------
# The mandatory minimum markup over the verified provider cost, in basis points
# (1000 = 10%). Every social-boost order must earn at least this, and it is
# enforced twice: when a pricing rule is saved, and again immediately before the
# wallet is debited. It is a floor, not a band — a higher margin is a better
# price, not a worse one.
#
# Markup is not margin: a 10% markup on NGN 1,000 charges NGN 1,100 and earns
# NGN 100, which is a 9.09% gross margin (profit / price).
SMM_MINIMUM_MARKUP_BPS=1000

# How long a synchronised provider rate stays usable. Nitro improves rates
# automatically as monthly volume climbs, so a stale rate is wrong in the
# direction that costs money — we would sell at yesterday's cost and buy at
# today's. The catalogue syncs hourly, so a day is a wide margin that still
# catches a sync which has been silently failing.
SMM_RATE_MAX_AGE_HOURS=24

# Whether a purchase may proceed on a stale rate. Off by default: a stale rate is
# a guess with a timestamp on it.
SMM_ALLOW_STALE_RATE=false

# How many orders one reconciliation pass polls. Nitro documents 300 requests per
# minute and this sweep makes one request per order — bulk polling is deliberately
# not used, because the documentation does not say its batch response is
# index-aligned with the ids sent, and mapping the wrong entry onto the wrong
# order would apply one customer's outcome to another's. This bound is what keeps
# a backlog from spending the whole allowance in one tick.
SMM_RECONCILE_BATCH=50

# How long a social-boost price-change confirmation stays valid, in seconds. Same
# contract as the data one: "you showed me this figure and I accept it".
SMM_PRICE_QUOTE_TTL_SECONDS=300

# The quantity increment the order form offers. Nitro publishes only a minimum
# and a maximum, so the honest step is 1 — the provider accepts any integer in
# range. Raise it only if your services are genuinely sold in whole thousands,
# because rounding a customer's quantity up charges them for units they did not
# ask for.
SMM_QUANTITY_STEP=1

# --- Network detection -------------------------------------------------------
# Whether a phone number's prefix may be used to pre-select a network.
#
# On by default, because it is the only detection available: neither ClubKonnect
# nor Pairgate publishes a number-to-network lookup, so turning it off removes
# detection entirely rather than replacing it with something better.
#
# It is a HINT and never a fact. Nigeria has had mobile number portability since
# 2013, so a prefix does not determine the serving network. What it does is
# pre-select the likely network and let the server stop a purchase whose selected
# network contradicts the number — with the customer able to confirm and override
# for a genuinely ported line.
NETWORK_ALLOW_PREFIX_INFERENCE=true

# --- Network-specific data discounts -----------------------------------------
# The rate actually paid for a data bundle as a fraction of ClubKonnect's
# published price, in basis points. The supplied schedule is 0.970 MTN, 0.955
# Glo, 0.930 T2mobile, 0.970 Airtel, so:
#
#     MTN      x 0.970 -> 9700 bps
#     Glo      x 0.955 -> 9550 bps
#     T2mobile x 0.930 -> 9300 bps
#     Airtel   x 0.970 -> 9700 bps
#
# These become ProviderNetworkCost rows for the `data` capability, seeded
# UNVERIFIED, so the gross profit recorded on a bundle is flagged `estimated`
# until somebody confirms the rate against a provider invoice. A discount is not
# profit: ReUp's margin is the selling price minus this effective cost, and it is
# computed from both figures rather than inferred from the discount.
DATA_DISCOUNT_BPS_MTN=9700
DATA_DISCOUNT_BPS_GLO=9550
DATA_DISCOUNT_BPS_9MOBILE=9300
DATA_DISCOUNT_BPS_AIRTEL=9700

# Whether ClubKonnect's catalogue price for a bundle is the price BEFORE the
# per-network discount. It returns its published rate, which carries no discount,
# so the schedule above is applied once and this stays true.
#
# Set it to false if the provider ever starts returning net pricing. Applying a
# discount twice understates cost, overstates profit, and prices sales below what
# we actually pay — the one direction this cannot be wrong in.
DATA_CATALOGUE_PRICE_IS_GROSS=true

# Catalogue sync and monitoring. The sync reads provider catalogues and updates
# our cost figures; it never creates a sellable product, because matching a
# provider's plan name to ours by similarity would sell the wrong thing.
#
# Bounds the international walk (country -> product type -> operator ->
# variation). A full walk is hundreds of requests against a rate-limited API, so
# name the markets ReUp actually sells into.
PROVIDER_SYNC_COUNTRIES=GH,KE,ZA,UG,TZ
PROVIDER_SYNC_VTPASS_COUNTRIES=5
PROVIDER_SYNC_HEALTH_DAYS=90

# Alert thresholds. Both are proportions in basis points: 1000 = 10%.
# A cost that moves by more than this is worth reviewing before the margin it
# feeds is discovered to have gone.
PROVIDER_COST_CHANGE_BPS=1000
PROVIDER_FAILURE_RATE_BPS=1000
# Consecutive failed probes before a provider is treated as down. Three, because
# one dropped connection is not an outage and a monitor that says it is gets
# ignored.
PROVIDER_FAILURES_BEFORE_DOWN=3
# A shorter timeout for read-only probes that gate a purchase decision.
PROVIDER_PROBE_TIMEOUT=10
PROVIDER_HTTP_TIMEOUT=30

# ---------------------------------------------------------------------------
# Spend controls (bank-level limits, in naira)
# ---------------------------------------------------------------------------
LIMIT_PER_TRANSACTION=200000
LIMIT_DAILY_PER_USER=500000
LIMIT_MONTHLY_PER_USER=5000000
# Platform-wide daily payout ceiling. 0 disables it.
LIMIT_PLATFORM_DAILY=0
LIMIT_PURCHASES_PER_MINUTE=6
LIMIT_DUPLICATE_WINDOW=20

# ---------------------------------------------------------------------------
# Exam PIN pricing
# ---------------------------------------------------------------------------
PRICE_WAEC_PIN=3500
PRICE_JAMB_UTME_PIN=7700
PRICE_JAMB_DE_PIN=5700

# ---------------------------------------------------------------------------
# Provider costs and profitability
# ---------------------------------------------------------------------------
# What a provider charges ReUp is recorded per provider and network in the
# `provider_network_costs` table, editable by a Super Admin at
# /admin/pricing/costs. These variables are the *policy* for using it — there is
# deliberately no setting that sells on an invented cost.
#
# What happens when a transaction needs a provider cost and none can be
# established. `refuse` blocks the sale with a customer-friendly message;
# `refuse_pending_review` does the same and flags it for an administrator.
PROVIDER_COST_POLICY=refuse

# How long a verified cost stays usable before it must be re-verified. A stale
# cost is treated as unknown, not as truth: the provider may have re-priced, and
# selling on a stale cost is how a margin disappears unnoticed.
PROVIDER_COST_MAX_AGE_HOURS=168

# Whether a configured *assumption* (an airtime discount rate that nobody has
# yet confirmed against a provider statement) may price a sale. When it does, the
# profit measured on it is recorded as ESTIMATED, never as realised.
PROVIDER_COST_ALLOW_ASSUMPTIONS=true

# Whether a cost older than PROVIDER_COST_MAX_AGE_HOURS may still be used. Off by
# default: a stale cost is a guess with a timestamp on it.
PROVIDER_COST_ALLOW_STALE=false

# The seed value for the airtime discount, in basis points (300 = 3%), applied
# per network by `php artisan pricing:seed-airtime-costs`. It is NOT read on the
# purchase path — change the live rate in the admin console, and confirm the real
# figure against a ClubKonnect statement before trusting any margin it produces.
AIRTIME_DISCOUNT_BPS=300

# The starting markup for data bundles, in basis points (300 = 3%), applied by
# PricingDefaultsSeeder as a global rule. 3% is the top of the approved band and
# the figure an operator should be moving DOWN from where the market allows it.
#
# Markup is not margin: it applies to the verified provider cost, so a 3% markup
# on a ₦1,000 bundle charges ₦1,030 — a ₦30 gross profit, which is a 2.91% gross
# margin (profit ÷ price). A network-scoped rule overrides this one.
DATA_DEFAULT_MARKUP_BPS=300

# The approved band for a data-bundle markup, in basis points (200 = 2%). A
# global or network-scoped percentage rule must fall inside it, and the pricing
# console refuses one that does not — which is what turns "2–3%" into a rule the
# system keeps rather than a sentence in a brief. Rules that already exist
# outside the band keep working; the band governs new and edited rules, because
# silently re-pricing live bundles would change what customers are charged
# without anybody deciding to.
DATA_MARKUP_BPS_MIN=200
DATA_MARKUP_BPS_MAX=300

# --- Data-bundle catalogue synchronisation -----------------------------------
# The catalogue carries both the bundles and what each costs ReUp, so a stale one
# is a set of prices derived from costs nobody has checked. The scheduled sync
# (`data:sync-catalogue`, every minute on the scheduler) fetches at most once per
# CATALOGUE_SYNC_INTERVAL_SECONDS — the interval between *provider* reads, which
# is what keeps a per-minute tick from spending the rate limit purchases need.
CATALOGUE_SYNC_INTERVAL_SECONDS=600

# How old the last successful synchronisation may be before the catalogue is
# reported as stale — on the provider dashboard, on the pricelist API and in
# `php artisan data:sync-catalogue --status`. Three missed runs at the interval
# above: a provider problem rather than a hiccup.
CATALOGUE_STALE_AFTER_SECONDS=1800

# How often an open purchase page re-reads the price list from ReUp. Never from
# the provider: the scheduled synchronisation is what refreshes the catalogue,
# and the browser only refreshes what it displays.
CATALOGUE_FRONTEND_REFRESH_SECONDS=300

# How long a price-change confirmation stays valid. A confirmation is "you showed
# me this figure and I accept it", and the figure is only meaningful while the
# provider cost and the pricing rule behind it are unchanged.
DATA_PRICE_QUOTE_TTL_SECONDS=300

# Seconds to wait for the provider's catalogue endpoint during a synchronisation.
CATALOGUE_SYNC_TIMEOUT_SECONDS=30

# Consecutive failed synchronisations before an alert is raised on the provider
# dashboard. Three, matching the provider health monitor: alerting on a single
# dropped connection teaches an operator to ignore the alert.
CATALOGUE_FAILURES_BEFORE_ALERT=3

# Whether the mobile network may be guessed from a phone number's prefix as an
# advisory hint. Off by default: number portability means a prefix does not
# reliably indicate the serving network, so a prefix is never persisted as a
# transaction's network.
NETWORK_ALLOW_PREFIX_INFERENCE=false

# If your ClubKonnect account has a confirmed airtime discount, set it here and
# re-run `php artisan db:seed`. Overrides per network when set.
# ADMIN_SEED_PASSWORD=

# Dedicated virtual account (DVA) bank for bank-transfer funding.
# Paystack issues a permanent NUBAN per customer; inbound transfers are credited
# by webhook (channel=dedicated_nuban). Supported: wema-bank, titan-paystack.
# Requires a Paystack account that has completed go-live; until then
# POST /wallet/fund with bank_transfer falls back to the static account below.
PAYSTACK_DVA_BANK=wema-bank

# WhatsApp support bubble. Must be the international format with no "+" and no
# leading zero (a Nigerian 0707... number becomes 234707...). The click-to-chat
# URL is derived from this at boot; leave blank to hide the bubble entirely.
SUPPORT_WHATSAPP=2347074217206
SUPPORT_WHATSAPP_MESSAGE="Hello ReUp, I need help with my account."
