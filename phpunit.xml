<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>
    </testsuites>
    <coverage processUncoveredFiles="true">
        <include>
            <directory suffix=".php">./app</directory>
        </include>
    </coverage>
    <php>
        <server name="APP_ENV" value="testing"/>
        <server name="BCRYPT_ROUNDS" value="4"/>
        <server name="CACHE_DRIVER" value="array"/>
        <!--
            Test database isolation. These MUST stay uncommented.

            With no DB_* override here, the suite runs against whatever .env
            points at — which for this project is the development database. Tests
            use RefreshDatabase, i.e. migrate:fresh, so a plain `php artisan test`
            silently wipes the developer's data. That is exactly what happened
            once; the database below is a throwaway.

            MySQL rather than sqlite: the migrations are not engine-portable
            (2026_02_10_000001 uses `UPDATE ... LEFT JOIN`, which SQLite rejects),
            so running the suite on MySQL keeps it honest about what production
            will do. Create it once with:
                CREATE DATABASE reup_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
        -->
        <server name="DB_CONNECTION" value="mysql"/>
        <server name="DB_DATABASE" value="reup_test"/>
        <server name="MAIL_MAILER" value="array"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <server name="SESSION_DRIVER" value="array"/>
        <server name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
