<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>
    </testsuites>
    <coverage processUncoveredFiles="true">
        <include>
            <directory suffix=".php">./app</directory>
        </include>
    </coverage>
    <php>
        <!--
            `force="true"` on every one of these, and it is load-bearing.

            A PHPUnit `<server>` element only *sets* a variable — it does not override
            one that is already in the environment. On a machine where another project
            has exported `DB_DATABASE`, `DB_USERNAME` or `SESSION_DRIVER` process-wide
            (a `composer run dev` in a sibling checkout does exactly that), those
            values silently win and the suite:

              * runs against the wrong database, or fails with "Access denied" for
                another project's user;
              * migrates a database shared with that project, which then has its
                tables altered mid-run — surfacing as
                "Table definition has changed, please retry transaction" from deep
                inside a test rather than as anything naming the cause.

            All three happened here. `force` is what makes the test configuration
            authoritative over the ambient environment, so a developer's shell cannot
            change what the test suite does.
        -->
        <server name="APP_ENV" value="testing" force="true"/>
        <server name="APP_URL" value="http://localhost" force="true"/>
        <server name="BCRYPT_ROUNDS" value="4" force="true"/>
        <server name="CACHE_DRIVER" value="array" force="true"/>
        <!--
            Test database isolation. These MUST stay uncommented.

            With no DB_* override here, the suite runs against whatever .env
            points at — which for this project is the development database. Tests
            use RefreshDatabase, i.e. migrate:fresh, so a plain `php artisan test`
            silently wipes the developer's data. That is exactly what happened
            once; the database below is a throwaway.

            MySQL rather than sqlite: the migrations are not engine-portable
            (2026_02_10_000001 uses `UPDATE ... LEFT JOIN`, which SQLite rejects),
            so running the suite on MySQL keeps it honest about what production
            will do. Create it once with:
                CREATE DATABASE reup_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
        -->
        <server name="DB_CONNECTION" value="mysql" force="true"/>
        <server name="DB_DATABASE" value="reup_test" force="true"/>
        <server name="DB_USERNAME" value="root" force="true"/>
        <server name="DB_PASSWORD" value="" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <server name="TELESCOPE_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
